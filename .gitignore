# =============================================================================
# .gitignore - WikiStub-Seed
# =============================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*.pyc
*$py.class
*.egg-info/
*.egg
.eggs/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.db
data/
!web_publisher/data/
!web_publisher/data/*.json

# ---- Virtuelle Umgebungen ----
venv/
.venv/
env/
.env/

# ---- Interne Steuerungsdateien (NIEMALS in Git!) ----
AUFGABEN.txt
TEST.txt
TESTS.txt
TESTERGEBNISSE.txt
BUGREPORT.md
DIAGNOSE_REPORT.md

# ---- Persoenliche / Sensible Daten ----
_USER/
.env
.env.*
credentials.json
client_secret*.json
token.json
secrets.*
*.pem
*.key
keyring/

# ---- Build-Artefakte & Releases ----
releases/
*.exe
*.msi
*.msix
*.appx
*.spec
*.temp

# ---- IDE & Editoren ----
.claude/
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Betriebssystem ----
desktop.ini
Thumbs.db
.DS_Store
ehthumbs.db

# ---- Planung & Interne Doku ----
PLAN.txt

# ---- Private / Archive ----
_archive/
_private/

# ---- Logs ----
*.log

# ---- Projektspezifisch ----
output/
backups/
*.bak
*.tmp
*-ASUS-GEI.md
DECISIONS.md
PORTIERUNGSPLAN.md
DONE.md

# ---- Übersetzungs-Artefakte (lokale Pfade, nicht für public Repo) ----
_translate/
TRANSLATION-PROGRESS.md

# ---- edit_server.py: lokaler Runtime-Zustand, niemals committen ----
# wiki_auth.json traegt einen Passwort-HASH (siehe wiki_auth.py) und
# wikistub_seed_trash.json den Inhalt geloeschter Artikel/Kategorien --
# beides ist instanzspezifisch, nicht Teil des Datensatzes.
wiki_auth.json
wikistub_seed_trash.json

# ---- Multi-Host-Synchronisationskonflikte ----
*conflicted copy*
* (Kopie)*
* (Copy)*
* (kopie)*
* (copy)*
*-conflict-*
*.sync-conflict-*
*.conflict*
*-CONFLIT-*
*.sync-temp-*
*-ASUS-GEI*
*-ASUS*
*-WORKSTATION-LG*
*-WORKSTATION*
*-LAPTOP*
*-Mac Studio*
*-MacBook*

# ---- Multi-Agent & Canonical Lock-System ----
LOCK
LOCK.*
*.lock
LOCK*.txt
LOCK.user.*
LOCK.until.*
LOCK.condition.*
LOCK.permissions.json
.automation-lock
uv.lock
!package-lock.json

# ---- Test-, Coverage- & Packaging-Caches ----
coverage/
.coverage.*
.nyc_output/
.hypothesis/
.turbo/
.pytest_temp/
.tox/
wheelhouse/
.wheel-smoke/

# ---- Node & Web Packages ----
node_modules/

# ---- Merge- & Patch-Artefakte ----
*.orig
*.rej
