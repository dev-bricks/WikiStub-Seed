# ---- Python ----
__pycache__/
*.py[cod]
*.pyc
*$py.class
*.egg-info/
*.egg
.eggs/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.db
*.sqlite*
*.bachdb*
data/
data/temp/**
!web_publisher/data/
!web_publisher/data/*.json

# ---- Pre-Push Data-Gate Exclusions (SEC-bach-rescue-tag-2026-11-22) ----
*export*.csv
*dump*
inbox_config*
TO-DECIDE-USER*
LOCK-CACHE*
CONFLICT_REVIEW_LOG*

# ---- Virtuelle Umgebungen ----
venv/
.venv/
env/
.env/

# ---- Interne Steuerungsdateien (NIEMALS in Git!) ----
AUFGABEN.txt
TEST.txt
TESTS.txt
TESTERGEBNISSE.txt
BUGREPORT.md
DIAGNOSE_REPORT.md

# ---- Persoenliche / Sensible Daten & Keys ----
_USER/
.env
.env.local
.env.*
!.env.example
!.env.sample
.npmrc
.pypirc
credentials.json
client_secret*.json
token.json
tokens.json
*secret*.json
*token*.json
secrets.*
*.token
*.secret
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.cert
*.csr
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
*_recovery_codes.txt
*recovery*codes*.txt
keyring/

# ---- Build-Artefakte & Releases ----
releases/
*.exe
*.msi
*.msix
*.appx
*.spec
*.temp

# ---- IDE & Editoren ----
.claude/
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Betriebssystem ----
desktop.ini
Desktop.ini
Thumbs.db
.DS_Store
ehthumbs.db

# ---- Planung & Interne Doku ----
PLAN.txt
TASKPLAN_*.md

# ---- Private / Archive ----
_archive/
_private/

# ---- Logs ----
*.log

# ---- Projektspezifisch ----
output/
backups/
*.bak
*.tmp
*-ASUS-GEI.md
DECISIONS.md
PORTIERUNGSPLAN.md
DONE.md

# ---- Übersetzungs-Artefakte (lokale Pfade, nicht für public Repo) ----
_translate/
TRANSLATION-PROGRESS.md

# ---- edit_server.py: lokaler Runtime-Zustand, niemals committen ----
# wiki_auth.json traegt einen Passwort-HASH (siehe wiki_auth.py) und
# wikistub_seed_trash.json den Inhalt geloeschter Artikel/Kategorien --
# beides ist instanzspezifisch, nicht Teil des Datensatzes.
wiki_auth.json
wikistub_seed_trash.json

# ---- Multi-Host-Synchronisationskonflikte ----
*conflicted copy*
* (Kopie)*
* (Copy)*
* (kopie)*
* (copy)*
*-conflict-*
*.sync-conflict-*
*.conflict*
*-CONFLIT-*
*.sync-temp-*
*-ASUS-GEI*
*-ASUS*
*-IDEAPAD*
*-IDEAPAD-GEI*
*-WORKSTATION-LG*
*-WORKSTATION*
*_WORKSTATION*
*_WORKSTATION-LG*
*-WORKSTATION.*
*-WORKSTATION-LG.*
*-LAPTOP*
*-Mac Studio*
*-MacBook*

# ---- Multi-Agent & Canonical Lock-System ----
LOCK
LOCK.*
*.lock
LOCK*.txt
LOCK.user.*
LOCK.until.*
LOCK.condition.*
LOCK.dev.*
LOCK.antigravity.*
LOCK.bugsearch.*
LOCK.permissions.json
.automation-lock
uv.lock
!package-lock.json

